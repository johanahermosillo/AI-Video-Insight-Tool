            self.feedback_text.insert(tk.END, "ANALYSIS OF THE MOVEMENT:\n", "category")
            self.feedback_text.insert(tk.END, f"Movement efficiency: {r['efficiency']}\n")
            self.feedback_text.insert(tk.END, f"Symmetry: {r['symmetry']}\n")
            self.feedback_text.insert(tk.END, f"Speed performance: {r['max_speed']}\n")
            self.feedback_text.insert(tk.END, f"Acceleration: {r['acceleration']}\n\n")
        
        # General recommendations
        self.feedback_text.insert(tk.END, "GENERAL RECOMMENDATIONS\n", "subheading")
        self.feedback_text.insert(tk.END, "---------------------------\n\n")
        
        all_recommendations = []
        for analysis_type, results in self.analysis_results.items():
            all_recommendations.extend(results.get("recommendations", []))
        
        # Remove duplicates
        unique_recommendations = list(set(all_recommendations))
        
        for i, rec in enumerate(unique_recommendations):
            self.feedback_text.insert(tk.END, f"{i+1}. {rec}\n")
        
        self.feedback_text.insert(tk.END, "\nACTION PLAN\n", "subheading")
        self.feedback_text.insert(tk.END, "---------------\n\n")
        
        # Generate action plan based on analysis
        self.feedback_text.insert(tk.END, "Short term (1-2 weeks):\n")
        if "injuries" in self.analysis_results:
            self.feedback_text.insert(tk.END, "• Modify technique to reduce stress in identified areas\n")
            self.feedback_text.insert(tk.END, "• Start specific strengthening exercises\n")
        else:
            self.feedback_text.insert(tk.END, "• Perform a complete evaluation with a specialist\n")
            self.feedback_text.insert(tk.END, "• Review sports equipment\n")
        
        self.feedback_text.insert(tk.END, "\nMedium term (3-4 weeks):\n")
        if "posture" in self.analysis_results:
            self.feedback_text.insert(tk.END, "• Incorporate corrective posture exercises\n")
        if "movement" in self.analysis_results:
            self.feedback_text.insert(tk.END, "• Work on technique in specific improvement points\n")
        self.feedback_text.insert(tk.END, "• Follow-up to evaluate progress\n")
        
        self.feedback_text.insert(tk.END, "\nLong term (2-3 months):\n")
        self.feedback_text.insert(tk.END, "• Incorporate permanent technical changes\n")
        self.feedback_text.insert(tk.END, "• Personalized injury prevention program\n")
        self.feedback_text.insert(tk.END, "• Complete progress reevaluation\n")
        
