            return
        
        self.results_text.config(state=tk.NORMAL)
        self.results_text.delete(1.0, tk.END)
        
        # Display results in readable format
        self.results_text.insert(tk.END, f"=== {results['type']} ===\n\n", "heading")
        
        # Format depends on analysis type
        if results["type"] == "Analysis of the Posture":
            self.results_text.insert(tk.END, f"• Column alignment: {results['column_alignment']}\n")
            self.results_text.insert(tk.END, f"• Weight distribution: {results['weight_distribution']}\n")
            self.results_text.insert(tk.END, f"• Knee angle: {results['knee_angle']}\n")
            self.results_text.insert(tk.END, f"• Risk level: {results['risk_level']}\n\n")
            
        elif results["type"] == "Possible Injury Detection":
            self.results_text.insert(tk.END, "Identified risk areas:\n")
            for area in results["risk_areas"]:
                self.results_text.insert(tk.END, f"• {area['zone']} - Level: {area['level']}\n")
                self.results_text.insert(tk.END, f"  Likely cause: {area['cause']}\n")
            
            self.results_text.insert(tk.END, f"\nMovement patterns: {results['movement_patterns']}\n")
            self.results_text.insert(tk.END, f"Follow-up: {results['follow_up']}\n\n")
            
        elif results["type"] == "Analysis of the Movement":
            self.results_text.insert(tk.END, f"• Efficiency: {results['efficiency']}\n")
            self.results_text.insert(tk.END, f"• Symmetry: {results['symmetry']}\n")
            self.results_text.insert(tk.END, f"• Max speed: {results['max_speed']}\n")
            self.results_text.insert(tk.END, f"• Acceleration: {results['acceleration']}\n\n")
            
            self.results_text.insert(tk.END, "Improvement points:\n")
            for punto in results["improvement_points"]:
