        self.feedback_text.tag_configure("subheading", font=("Helvetica", 11, "bold"))
        self.feedback_text.tag_configure("category", font=("Helvetica", 10, "bold"))
    
    def save_pdf(self):
        if not self.feedback_text.get(1.0, tk.END).strip():
            messagebox.showinfo("NOTE", "No feedback content to save.")
            return
        
        try:
            from reportlab.lib.pagesizes import letter
            from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer
            from reportlab.lib.styles import getSampleStyleSheet
            
            file_path = filedialog.asksaveasfilename(
                defaultextension=".pdf",
                filetypes=[("PDF files", "*.pdf"), ("All files", "*.*")],
                title="Save report as PDF"
            )
            
            if not file_path:
                return
            
            # Create PDF
            doc = SimpleDocTemplate(file_path, pagesize=letter)
            styles = getSampleStyleSheet()
            elements = []
            
            # Title
            athlete_name = self.athlete_name.get() or "Athlete"
            elements.append(Paragraph(f"Report of Athletes: {athlete_name}", styles["Title"]))
            elements.append(Spacer(1, 12))
            
            # Add content from feedback text
            text_content = self.feedback_text.get(1.0, tk.END)
            for line in text_content.split('\n'):
                if line.strip():
                    if line.isupper():  # Headings
                        elements.append(Paragraph(line, styles["Heading1"]))
                    elif line.startswith('--'):  # Separators
                        elements.append(Spacer(1, 6))
                    else:
                        elements.append(Paragraph(line, styles["Normal"]))
                elements.append(Spacer(1, 6))
            
            # Build PDF
            doc.build(elements)
            
            messagebox.showinfo("Success", f"Report saved as {file_path}")
            
        except ImportError:
            messagebox.showerror("Error", "To save as PDF you need to install ReportLab:\n\npip install reportlab")
        except Exception as e:
            messagebox.showerror("Error", f"Error saving PDF: {str(e)}")
    
    def save_notes(self):
        notes_text = self.notes_text.get(1.0, tk.END).strip()
        if not notes_text:
            messagebox.showinfo("NOTE", "No notes to save.")
            return
        
        file_path = filedialog.asksaveasfilename(
            defaultextension=".txt",
            filetypes=[("Text files", "*.txt"), ("All files", "*.*")],
            title="Save notes"
        )
        
        if file_path:
            try:
                with open(file_path, 'w', encoding='utf-8') as file:
                    file.write(notes_text)
                messagebox.showinfo("Success", f"Notes saved in {file_path}")
            except Exception as e:
                messagebox.showerror("Error", f"Error saving notes: {str(e)}")
    
    def save_analysis(self):
        if not self.selected_video or not self.analysis_results:
            messagebox.showinfo("NOTE", "No analysis to save.")
            return
        
        athlete_name = self.athlete_name.get()
        if not athlete_name:
            messagebox.showinfo("NOTE", "Please enter the athlete's name.")
            return
        
        # Prepare data to save
        data = {
            "athlete": {
                "name": athlete_name,
                "sport": self.sport_type.get(),
                "session_date": self.session_date.get(),
                "height": self.height_var.get(),
                "weight": self.weight_var.get(),
                "age": self.age_var.get(),
                "injury_history": self.injury_history.get(1.0, tk.END).strip()
            },
            "video": os.path.basename(self.selected_video),
            "analysis_results": self.analysis_results,
            "annotations": self.annotations,
            "notes": self.notes_text.get(1.0, tk.END).strip(),
            "feedback": self.feedback_text.get(1.0, tk.END).strip()
        }
        
        # Create safe filename
        safe_name = athlete_name.lower().replace(" ", "_")
        date_str = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        filename = f"{safe_name}_{date_str}.json"
        filepath = os.path.join("athlete_data", filename)
        
        try:
            with open(filepath, 'w', encoding='utf-8') as f:
                json.dump(data, f, ensure_ascii=False, indent=4)
            
            messagebox.showinfo("Success", f"Analysis saved as {filename}")
        except Exception as e:
            messagebox.showerror("Error", f"Error saving analysis: {str(e)}")
    
    def load_analysis(self):
        filepath = filedialog.askopenfilename(
            title="Load analysis",
            filetypes=[("JSON files", "*.json"), ("All files", "*.*")],
            initialdir="athlete_data"
        )
        
        if not filepath:
            return
        
        try:
            with open(filepath, 'r', encoding='utf-8') as f:
                data = json.load(f)
            
            # Load athlete data
            athlete = data.get("athlete", {})
            self.athlete_name.set(athlete.get("name", ""))
            self.sport_type.set(athlete.get("sport", ""))
            self.session_date.set(athlete.get("session_date", ""))
            self.height_var.set(athlete.get("height", ""))
            self.weight_var.set(athlete.get("weight", ""))
            self.age_var.set(athlete.get("age", ""))
            
            self.injury_history.delete(1.0, tk.END)
            self.injury_history.insert(tk.END, athlete.get("injury_history", ""))
            
            # Load annotations and analysis results
            self.annotations = data.get("annotations", [])
            self.analysis_results = data.get("analysis_results", {})
            
            # Load notes and feedback
            self.notes_text.delete(1.0, tk.END)
            self.notes_text.insert(tk.END, data.get("notes", ""))
            
            self.feedback_text.delete(1.0, tk.END)
            self.feedback_text.insert(tk.END, data.get("feedback", ""))
            
            # Show analysis results if available
            if self.analysis_results:
                for analysis_type, results in self.analysis_results.items():
                    self.display_analysis_results(results)
                    break  # Just show the first analysis
            
            messagebox.showinfo("Success", "Analysis loaded successfully.")
            
        except Exception as e:
            messagebox.showerror("Error", f"Error loading analysis: {str(e)}")
    
