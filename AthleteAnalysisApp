    def browse_video(self):
        filetypes = (
            ("Video files", "*.mp4 *.avi *.mov *.mkv *.wmv"),
            ("All files", "*.*")
        )
        
        video_path = filedialog.askopenfilename(
            title="Select a video",
            filetypes=filetypes
        )
        
        if video_path:
            self.load_video(video_path)
    
    def load_video(self, video_path):
        if self.cap is not None:
            self.cap.release()
        
        self.cap = cv2.VideoCapture(video_path)
        if not self.cap.isOpened():
            messagebox.showerror("Error", "We could not upload a video.")
            return
        
        self.selected_video = video_path
        self.frame_count = int(self.cap.get(cv2.CAP_PROP_FRAME_COUNT))
        self.current_frame_pos = 0
        self.annotations = []
        
        # Reset UI
        self.progress_var.set(0)
        self.results_text.config(state=tk.NORMAL)
        self.results_text.delete(1.0, tk.END)
        self.results_text.insert(tk.END, f"Uploaded Video: {os.path.basename(video_path)}\n")
        self.results_text.insert(tk.END, f"Total Frames: {self.frame_count}\n")
        self.results_text.insert(tk.END, "Make an analysis to see the results.\n")
        self.results_text.config(state=tk.DISABLED)
        
        self.feedback_text.delete(1.0, tk.END)
        
        # Show first frame
        self.update_frame()
    
    def update_frame(self):
        if self.cap is None:
            return
        
        ret, frame = self.cap.read()
        if not ret:
            self.reset_video()
            return
        
        # Store current frame for analysis
        self.current_frame = frame
        
        # Resize to fit canvas
        canvas_width = self.canvas.winfo_width()
        canvas_height = self.canvas.winfo_height()
        
        if canvas_width > 1 and canvas_height > 1:
            # Calculate aspect ratio
            frame_height, frame_width = frame.shape[:2]
            aspect_ratio = frame_width / frame_height
            
            # Resize maintaining aspect ratio
            if canvas_width / canvas_height > aspect_ratio:
                new_height = canvas_height
                new_width = int(new_height * aspect_ratio)
            else:
                new_width = canvas_width
                new_height = int(new_width / aspect_ratio)
            
            frame = cv2.resize(frame, (new_width, new_height))
        
        # Draw annotations on frame
        for annotation in self.annotations:
            cv2.circle(frame, (annotation["x"], annotation["y"]), 5, (0, 255, 0), -1)
            cv2.putText(frame, annotation["text"], (annotation["x"] + 10, annotation["y"]), 
                      cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)
        
        # Convert to PhotoImage
        frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        img = Image.fromarray(frame_rgb)
        img_tk = ImageTk.PhotoImage(image=img)
        
        # Update canvas
        self.canvas.config(width=img.width, height=img.height)
        self.canvas.create_image(0, 0, anchor=tk.NW, image=img_tk)
        self.canvas.image = img_tk  # Keep reference
        
        # Update progress bar
        self.current_frame_pos = int(self.cap.get(cv2.CAP_PROP_POS_FRAMES))
        if self.frame_count > 0:
            progress = (self.current_frame_pos / self.frame_count) * 100
            self.progress_var.set(progress)
    
    def toggle_play(self):
        if self.cap is None:
            return
        
        self.playing = not self.playing
        
        if self.playing:
            self.play_btn.config(text="⏸ Pause")
            self.play_video()
        else:
            self.play_btn.config(text="▶ Play")
    
    def play_video(self):
        if not self.playing or self.cap is None:
            return
        
        self.update_frame()
        
        # Check if we've reached the end
        if self.current_frame_pos >= self.frame_count - 1:
            self.playing = False
            self.play_btn.config(text="▶ Play")
            return
        
        # Schedule next frame update (approx. 30 fps)
        self.root.after(33, self.play_video)
    
    def reset_video(self):
        if self.cap is None:
            return
        
        self.playing = False
        self.play_btn.config(text="▶ Play")
        self.cap.set(cv2.CAP_PROP_POS_FRAMES, 0)
        self.current_frame_pos = 0
        self.progress_var.set(0)
        self.update_frame()
    
    def seek_video(self, value):
        if self.cap is None or self.frame_count == 0:
            return
        
        # Calculate frame position
        position = int((float(value) / 100) * self.frame_count)
        self.cap.set(cv2.CAP_PROP_POS_FRAMES, position)
        self.update_frame()
    
    def add_annotation(self, event):
        if self.current_frame is None:
            return
        
        x, y = event.x, event.y
        
        # Create annotation dialog
        annotation_window = tk.Toplevel(self.root)
        annotation_window.title("Add Anotations")
        annotation_window.geometry("300x150")
        annotation_window.transient(self.root)
        annotation_window.grab_set()
        
        ttk.Label(annotation_window, text="Text of the anotation:").pack(pady=5)
        
        text_var = tk.StringVar()
        text_entry = ttk.Entry(annotation_window, textvariable=text_var)
        text_entry.pack(fill=tk.X, padx=10, pady=5)
        text_entry.focus_set()
        
        def save_annotation():
            text = text_var.get()
            if text:
                self.annotations.append({"x": x, "y": y, "text": text, "frame": self.current_frame_pos})
                self.update_frame()  # Redraw frame with new annotation
            annotation_window.destroy()
        
        ttk.Button(annotation_window, text="Save", command=save_annotation).pack(pady=10)
    
    def analyze(self, analysis_type):
        if self.current_frame is None:
            messagebox.showinfo("NOTE", "Upload a video first.")
            return
        
        # Simulate analysis with progress dialog
        progress_window = tk.Toplevel(self.root)
        progress_window.title("Analyzing...")
        progress_window.geometry("300x100")
        progress_window.transient(self.root)
        progress_window.grab_set()
        
        ttk.Label(progress_window, text=f"Making the analysis of {analysis_type}...").pack(pady=10)
        
        progress_var = tk.DoubleVar()
        progress = ttk.Progressbar(progress_window, variable=progress_var, maximum=100)
        progress.pack(fill=tk.X, padx=20, pady=10)
        
        def simulate_analysis():
            for i in range(101):
                progress_var.set(i)
                progress_window.update_idletasks()
                time.sleep(0.02)
            
            # Generate analysis results
            self.generate_analysis_results(analysis_type)
            progress_window.destroy()
        
        threading.Thread(target=simulate_analysis, daemon=True).start()
    
    def generate_analysis_results(self, analysis_type):
        # This would be where real analysis happens
        # For now, we'll generate some mock results
        results = {}
        
        if analysis_type == "posture":
            img_gray = cv2.cvtColor(self.current_frame, cv2.COLOR_BGR2GRAY)
            img_blur = cv2.GaussianBlur(img_gray, (5, 5), 0)
            edges = cv2.Canny(img_blur, 50, 150)
            
            # Simple mock analysis based on edge detection
            edge_percent = np.sum(edges > 0) / (edges.shape[0] * edges.shape[1])
            
            results = {
                "type": "Analysis of the Posture",
                "column_alignment": "Normal" if edge_percent < 0.15 else "Posible misalignment",
                "weight_distribution": "Balanced" if edge_percent < 0.2 else "Unbalanced",
                "knee_angle": "Adequate" if edge_percent < 0.18 else "Review recommended",
                "recommendations": [
                    "Keep your back straight during the exercise",
                    "Check the height of the seat/equipment",
                    "Consider core strengthening exercises"
                ],
                "risk_level": "Low" if edge_percent < 0.17 else "Moderate"
            }
            
        elif analysis_type == "injuries":
            # Mock lesion detection
            results = {
                "type": "Possible Injury Detection",
                "risk_areas": [
                    {"zone": "Right knee", "level": "Moderate", "cause": "Flexion angle"},
                    {"zone": "Lower back", "level": "Low", "cause": "Curvature"}
                ],
                "movement_patterns": "Compensation on right side",
                "recommendations": [
                    "Strengthen support muscles around the knee",
                    "Consider alternative technique to reduce joint stress",
                    "Evaluate sports footwear"
                ],
                "follow_up": "Recomemended in 2 weeks"
            }
            
        elif analysis_type == "movement":
            # Mock movement analysis
            results = {
                "type": "Analysis of Movement",
                "efficiency": "75%",
                "symmetry": "15% imbalance towards dominant side",
                "max_speed": "Adequate for level",
                "acceleration": "Suboptimal initial phase",
                "improvement_points": [
                    "Starting technique",
                    "Efffort distribution",
                    "Recovery phase"
                ],
                "recommendations": [
                    "Plyometric exercises to improve start",
